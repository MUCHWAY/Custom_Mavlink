    <messages>
        <message id="20000" name="SPEAKER_INFORMATION">
            <description>Information of speaker.</description>
            <field type="char[32]" name="vendor_name">Name of the speaker vendor.</field>
            <field type="char[32]" name="model_name">Name of the speaker model.</field>
            <field type="char[32]" name="serial_number">Serial number of the speaker.</field>
            <field type="char[32]" name="firmware_version">Version of the speaker firmware.</field>
        </message>
        <message id="20001" name="SPEAKER_STATUS">
            <description>Information of audio file.</description>
            <field type="uint8_t" name="play_mode" enum="SPEAKER_PLAY_AUDIO_MODE">Play audio mode.</field>
            <field type="uint8_t" name="play_status" enum="SPEAKER_PLAY_AUDIO_STATUS">Whether audio playing is currently in process.</field>
            <field type="float" name="playing_time_s">Elapsed time since starting the audio playing (in seconds).</field>
            <field type="float" name="current_volume">Current volume level (in persentage).</field>
            <field type="int32_t" name="network_module_status">Current network status.</field>
            <field type="float" name="roll">Value of speaker roll.</field>
            <field type="float" name="pitch">Value of speaker pitch.</field>
            <field type="float" name="yaw">Value of speaker yaw.</field>
            <field type="uint8_t" name="light_mode" enum="SPEAKER_LIGHT_MODE">Mode of speaker light.</field>
            <field type="uint8_t" name="light_on_off" enum="SPEAKER_LIGHT_ON_OFF">On/off of speaker light.</field>
        </message>
        <message id="20002" name="SPEAKER_STORAGE_INFORMATION">
