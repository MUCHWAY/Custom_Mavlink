    <messages>
        <message id="20000" name="SPEAKER_INFORMATION">
            <description>Information of speaker.</description>
            <field type="char[32]" name="vendor_name">Name of the speaker vendor.</field>
            <field type="char[32]" name="model_name">Name of the speaker model.</field>
            <field type="char[32]" name="serial_number">Serial number of the speaker.</field>
